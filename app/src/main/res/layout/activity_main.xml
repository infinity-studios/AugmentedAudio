<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="48dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:text="AUGMENTED"
            android:textColor="#7BE0C8"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Dream"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="20dp">

            <View
                android:id="@+id/orb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/orb" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Starting…"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/musicButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_selected"
                android:text="@string/btn_music"
                android:textAllCaps="false"
                android:textColor="#0A0F1F"
                android:textSize="15sp" />

            <Button
                android:id="@+id/micButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_idle"
                android:text="@string/btn_mic"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/importButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill_idle"
            android:text="＋  Import MP3"
            android:textAllCaps="false"
            android:textColor="#7BE0C8"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/SliderLabel" android:text="Drown — echo length" />
            <SeekBar android:id="@+id/drownBar" style="@style/DreamSlider" android:progress="70" />

            <TextView style="@style/SliderLabel" android:layout_marginTop="14dp" android:text="Song level" />
            <SeekBar android:id="@+id/songBar" style="@style/DreamSlider" android:progress="75" />

            <TextView style="@style/SliderLabel" android:layout_marginTop="14dp" android:text="Room pickup" />
            <SeekBar android:id="@+id/roomBar" style="@style/DreamSlider" android:progress="70" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/hint"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
